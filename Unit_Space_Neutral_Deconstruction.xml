<?xml version="1.0" encoding="UTF-8"?>
<Deconstruction_Dummy>
    <!--
        How this works:
        There is a Deconstruction Object for every secondary space structure,
        which becomes buildable when the respective structure is built. (Required_Special_Structures)

        When the deconstructon dummy is built, the attached ObjectScript (ObjectScript_Space_Building_Deconstruction)
        checks whether the dummy matches a secondary space structure and if so, it despawns the first one it finds on
        the respective planet.

        This way the same script can be used for every DeconstructionObject.


        To add a new deconstruction Object:
        - Create a new variant of Abstract_Deconstruction (see below for examples)
          A new Icon and new Encyclopedia_Text string are needed
        - Create a new if-case on ObjectScript_Space_Building_Deconstruction (see examples there)
     -->


    <MiscObject Name="Abstract_Deconstruction">
        <Text_ID>TEXT_DECONSTRUCT</Text_ID>
        <Encyclopedia_Unit_Class>TEXT_BUTTON_DECONSTRUCT</Encyclopedia_Unit_Class>
        <Behavior> DUMMY_STARSHIP </Behavior>
        <GUI_Row>0</GUI_Row>
        <Land_Model_Name>W_LASER_INVISIBLE.ALO</Land_Model_Name>
        <Victory_Relevant>No</Victory_Relevant>
        <Is_Valid_Target>No</Is_Valid_Target>
        <Affiliation>Rebel, Empire, Underworld</Affiliation>
        <Lua_Script>ObjectScript_Space_Building_Deconstruction</Lua_Script>
        <Build_Tab_Space_Units>Yes</Build_Tab_Space_Units>
        <Build_Cost_Credits>1</Build_Cost_Credits>
        <Build_Time_Seconds>1</Build_Time_Seconds>
        <Build_Initially_Locked>No</Build_Initially_Locked>
        <Tech_Level>99</Tech_Level>
        <Required_Star_Base_Level>1</Required_Star_Base_Level>
        <Required_Ground_Base_Level>0</Required_Ground_Base_Level>
        <Required_Special_Structures></Required_Special_Structures>
        <Required_Planets></Required_Planets>
        <Required_Timeline></Required_Timeline>
        <Population_Value>0</Population_Value>
    </MiscObject>

