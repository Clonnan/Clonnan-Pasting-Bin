  <!--The Horizon special ability requires several objects and scripts to work.
  We use weaken enemy to spawn a target object that shows the area that will be affected by the ability.
  A script then spawns the Horizon at the location of the Apollo and makes it move towards the target.
  When it's close enough the Horizon self destructs and releases six smaller missiles of which each moves to it's own target.
  When the smaler missiles are close to their target they self destruct with the power of a nuke. -->
  <MiscObject Name="Apollo_Horizon_Target">
    <Text_ID />
    <Space_Model_Name>PE_HORIZON_TARGET_EFFECT.ALO</Space_Model_Name>    <!--Wraith_Projectile_Plasmabomb.ALO-->
    <Scale_Factor>1.0</Scale_Factor>
    <Idle_Anim_00_Rate_Mod>1.0</Idle_Anim_00_Rate_Mod>
    <Behavior>DUMMY_ORBITAL_STRUCTURE, SPACE_OBSTACLE, IDLE</Behavior>
    <SpaceBehavior>ABILITY_COUNTDOWN, SELF_DESTRUCT, UNIT_AI</SpaceBehavior>
    <Layer_Z_Adjust>-5.0</Layer_Z_Adjust>
    <Sort_Order_Adjust>-1</Sort_Order_Adjust>
    <Remove_Upon_Death>true</Remove_Upon_Death>
    <Space_Layer> StaticObject </Space_Layer>
    <Selt_Destruct_SFXEvent_Start_Die>Effect_Empty_Sound</Selt_Destruct_SFXEvent_Start_Die>
    <Lua_Script>ObjectScript_Apollo_Horizon_Target</Lua_Script>
    <Unit_Abilities_Data SubObjectList="Yes">
